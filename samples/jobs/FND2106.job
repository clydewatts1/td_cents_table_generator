              -v NY_YEAR_PERIOD="${NY_YEAR_PERIOD:?}" \
              -v NY_YEAR_NUM="${NY_YEAR_NUM:?}" \
              ${STEP_DIR:?}/FND2106.300.VALIDATE.sql

#-------------------------------------------------------------------------------
# Step 310 : Validate that there is 1 business date
#-------------------------------------------------------------------------------

step 310 Bteq -s "${SERVER:?}" -u "${LOGON:?}" \
              -v MET_V="${MET_V}" \
              -v JOB="${JOB:?}" \
              -v STEP_NO=310 \
              -v INSTANCE="${INSTANCE:?}" \
              -v STREAMID="${STREAMID:?}" \
              -v LDTK_DATE="${LDTK_DATE:?}" \
