              -v NY_YEAR_END_DT="${NY_YEAR_END_DT:?}" \
              -v NY_PERIOD_START_DT="${NY_PERIOD_START_DT:?}" \
              -v NY_PERIOD_END_DT="${NY_PERIOD_END_DT:?}" \
              -v NY_WEEK_START_DT="${NY_WEEK_START_DT:?}" \
              -v NY_WEEK_END_DT="${NY_WEEK_END_DT:?}" \
              -v NY_DAY_OF_YEAR_NUM="${NY_DAY_OF_YEAR_NUM:?}" \
